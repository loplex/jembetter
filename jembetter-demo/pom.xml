<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cz.loplex</groupId>
    <artifactId>jembetter-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>jembetter-demo</artifactId>
  <packaging>jar</packaging>

  <name>jembetter-demo</name>
  <description>Runnable host/client demo apps used to manually verify the reparent + XEmbed pipeline end to end.</description>

  <dependencies>
    <dependency>
      <groupId>cz.loplex</groupId>
      <artifactId>jembetter-host</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>cz.loplex</groupId>
      <artifactId>jembetter-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- jembetter-core's X11ErrorHandler only logs (no println); the
         library itself ships no binding so embedding apps can pick their
         own. This demo IS the "normal run" a person actually launches, so
         it supplies one - see resources/simplelogger.properties for the
         DEBUG threshold that keeps X11 error visibility matching the old
         unconditional System.err.println behavior. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- maven-dependency-plugin: build-classpath regenerates target/cp.txt on every build, so
           the plain `java -cp` invocation in README.md never needs its own manual
           `mvn dependency:build-classpath` step first. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>build-classpath</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/cp.txt</outputFile>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- exec-maven-plugin: run either demo straight from Maven, e.g.
           `mvn -pl jembetter-demo exec:java@host` / `exec:java@client` - see README.md's "Try
           the demo" section. Neither execution is bound to a lifecycle phase, so
           `mvn package`/`install` never launches them on their own. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>host</id>
            <configuration>
              <mainClass>cz.loplex.jembetter.demo.HostDemo</mainClass>
              <classpathScope>runtime</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>client</id>
            <configuration>
              <mainClass>cz.loplex.jembetter.demo.ClientDemo</mainClass>
              <classpathScope>runtime</classpathScope>
            </configuration>
          </execution>
          <execution>
            <!-- Unlike host/client above, HostFacadeDemo spawns a second JVM
                 itself (see HostFacadeDemo#spawnClient), built from its own
                 `java.class.path` system property. Under goal `java`
                 (exec:java), that property is Maven's own launcher
                 classpath, not this module's - exec:java never forks a real
                 process, it runs in-process on a thread with a private
                 classloader - so the spawned child can't find its own
                 classes (ClassNotFoundException on ClientFacadeDemo). Goal
                 `exec` (exec:exec) genuinely forks `java`, so
                 `java.class.path` inside it is the real classpath below, and
                 the spawned grandchild works. The add-opens flags .mvn/jvm.config
                 gives Maven's own JVM don't reach this forked process either, so
                 they're repeated explicitly below. -->
            <id>host-facade</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>java</executable>
              <classpathScope>runtime</classpathScope>
              <arguments>
                <argument>--add-opens</argument>
                <argument>java.desktop/java.awt=ALL-UNNAMED</argument>
                <argument>--add-opens</argument>
                <argument>java.desktop/sun.awt.X11=ALL-UNNAMED</argument>
                <argument>--add-opens</argument>
                <argument>java.desktop/sun.awt.windows=ALL-UNNAMED</argument>
                <argument>-cp</argument>
                <classpath/>
                <argument>cz.loplex.jembetter.demo.HostFacadeDemo</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
