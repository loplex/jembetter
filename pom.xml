<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cz.loplex</groupId>
  <artifactId>jembetter-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Jembetter</name>
  <description>Reparenting of one X11 Java application's window into another via the XEmbed protocol.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>jembetter-core-common</module>
    <module>jembetter-core</module>
    <module>jembetter-core-win32</module>
    <module>jembetter-host</module>
    <module>jembetter-client</module>
    <module>jembetter-demo</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jna.version>5.19.1</jna.version>
    <junit.version>5.11.3</junit.version>
    <slf4j.version>2.0.18</slf4j.version>
    <!-- See the maven-surefire-plugin <jvm> configuration below and
         build-tools/test-jvm-wrapper/bin/java. Override on the command line,
         e.g. `-Dtest.xserver=Xephyr` to watch tests run, or
         `-Dtest.xserver=` to opt out and run against whatever DISPLAY you
         already have (or none). -->
    <test.xserver>Xvfb</test.xserver>
    <!-- Tests tagged "visual" (e.g. jembetter-host's VisualEmbedDemoTest)
         narrate themselves with Thread.sleep between steps for a human to
         watch - unattended runs like `mvn test`/`install` must skip them.
         To actually run one: `mvn test -Dtest.xserver=Xephyr -Dgroups=visual
         -Dtest.excludedGroups=` (the empty override is required - leaving
         the default in place would exclude the very tests -Dgroups=visual
         asks for). -->
    <test.excludedGroups>visual</test.excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna</artifactId>
        <version>${jna.version}</version>
      </dependency>
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna-platform</artifactId>
        <version>${jna.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- JNA loads its native library via System::load, which triggers a JEP 472
                 restricted-method warning on JDK 24+. Silence it for the test fork.
                 The "add opens" flags below are for CanvasNativeHandle's reflection into
                 java.awt.Component's package-private peer field and the peer's own
                 OS-specific accessor - getWindow() on X11, getHWnd() on Windows - see
                 that class's Javadoc. .mvn/jvm.config carries the same flags for Maven's
                 own JVM (what exec:java runs in), but that file has no effect on this
                 plugin's forked test JVM, so they're repeated here. -->
            <argLine>--enable-native-access=ALL-UNNAMED --add-opens java.desktop/java.awt=ALL-UNNAMED --add-opens java.desktop/sun.awt.X11=ALL-UNNAMED --add-opens java.desktop/sun.awt.windows=ALL-UNNAMED</argLine>
            <excludedGroups>${test.excludedGroups}</excludedGroups>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
          <configuration>
            <!-- Don't warn about missing comments/@param/@return; still check that
                 whatever Javadoc does exist is well-formed. -->
            <doclint>all,-missing</doclint>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Local-only packaging: every module's `mvn install` also produces a
        sources jar and a javadoc jar alongside the class jar, so a
        dependency picked up from the local repo (../.m2) has real IDE
        source/doc lookup. No distributionManagement here — nothing is
        configured to be pushed anywhere.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The Xvfb/openbox wrapper only makes sense on Linux/X11 - Windows has
         no DISPLAY, no Xvfb, and can't launch a shebang script as the forked
         test JVM's executable in the first place (CreateProcess needs a real
         PE binary, not a bash script). So this is a separate, unix-only
         profile rather than base pluginManagement: on windows-latest CI (or
         any Windows dev machine), the forked test JVM is surefire's own
         plain default fork, and the @EnabledOnOs(OS.WINDOWS)/DISPLAY-gated
         tests sort themselves out from there. -->
    <profile>
      <id>test-jvm-wrapper</id>
      <activation>
        <os>
          <family>unix</family>
        </os>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <!-- Launch the forked test JVM through a wrapper script instead of `java`
                     directly, so DISPLAY can be set (for tests gated on it - see README.md's
                     "Running tests" section) *before* that JVM starts. It has to happen that
                     early: a JVM decides whether it's headless from the DISPLAY it sees at
                     startup, and separately, once Maven's own JVM is running, nothing inside
                     it can hand the fork a DISPLAY it didn't already have - confirmed while
                     building this, both via a Maven property (interpolated once when the
                     reactor's build plan is put together, long before any phase/goal that
                     could produce a fresh value runs) and via a real libc setenv() call on
                     Maven's own process (maven-surefire-plugin's fork, via
                     plexus/maven-shared-utils Commandline, always builds the child's
                     environment from Java's System.getenv() snapshot - itself frozen at JVM
                     startup - rather than the live OS environment, so neither route ever
                     reaches the child). See build-tools/test-jvm-wrapper/bin/java for what the
                     wrapper actually does - it has to live at exactly
                     "<something>/bin/java<something>" (surefire's SystemUtils.endsWithJavaPath
                     requires a filename starting with "java" inside a directory literally named
                     "bin"), mimicking a real JDK install's own bin/java layout. -->
                <jvm>${maven.multiModuleProjectDirectory}/build-tools/test-jvm-wrapper/bin/java</jvm>
                <environmentVariables>
                  <ORIG_JAVA_HOME>${java.home}</ORIG_JAVA_HOME>
                  <X_SERVER>${test.xserver}</X_SERVER>
                </environmentVariables>
              </configuration>
              <executions>
                <execution>
                  <id>default-test</id>
                  <configuration>
                    <excludedGroups>windows</excludedGroups>
                  </configuration>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>

    <!-- The @Tag("windows") suite (jembetter-core-win32's Win32* primitives
         plus EmbedHostWin32Test/EmbedPlugWin32Test) also runs on Linux: a
         second surefire execution forks it, through the same test-jvm-wrapper,
         into a real Windows JDK running under Wine - see
         build-tools/test-jvm-wrapper/provide_platform_java.sh (which downloads
         and caches that JDK). Real Windows runs the identical suite as
         surefire's plain default fork on windows-latest CI.

         Gated on Wine actually being installed, checked via /usr/bin/wine -
         the standard Debian/Ubuntu/Arch/Fedora path - so a plain `mvn test`
         on a Wine-less Linux box skips this execution rather than failing
         the fork on `wine: command not found`. A Wine installed somewhere
         else needs an explicit `-Pwin32-tests-under-wine`. This profile
         layers onto test-jvm-wrapper above (always active together on Linux),
         inheriting its <jvm>/<environmentVariables> plugin configuration. -->
    <profile>
      <id>win32-tests-under-wine</id>
      <activation>
        <file>
          <exists>/usr/bin/wine</exists>
        </file>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <executions>
                <execution>
                  <id>windows-tests-on-linux</id>
                  <phase>test</phase>
                  <goals>
                    <goal>test</goal>
                  </goals>
                  <configuration>
                    <groups>windows</groups>
                    <!-- Excludes windows-tagged tests that are known to never pass under
                         Wine specifically (as opposed to on real Windows) - see the
                         comment on Win32ClickWatcherTest's
                         clickInsideAWatchedWindowInvokesTheCallback for the current
                         one. -->
                    <excludedGroups>wine-incompatible</excludedGroups>
                    <environmentVariables>
                      <TEST_GROUP>windows</TEST_GROUP>
                    </environmentVariables>
                    <!-- Default fork communication (LegacyForkNodeFactory) talks to the
                         forked JVM over its own stdin/stdout. Under Wine, reading that
                         inherited stdin hits an unimplemented Windows syscall (the
                         PeekNamedPipe equivalent JDK's BufferedInputStream calls from
                         available()), which kills the fork immediately. Route the same
                         communication over a TCP loopback socket instead - winsock is a
                         much better-supported part of Wine than console/pipe handle
                         emulation. runJava in provide_platform_java.sh also has to
                         propagate `wine java.exe`'s own exit code and ignore SIGPIPE on
                         the stderr relay for this to report reliably - see its comments. -->
                    <forkNode implementation="org.apache.maven.plugin.surefire.extensions.SurefireForkNodeFactory"/>
                  </configuration>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
