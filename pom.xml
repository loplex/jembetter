<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cz.loplex</groupId>
  <artifactId>xembed-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Jembetter</name>
  <description>Reparenting of one X11 Java application's window into another via the XEmbed protocol.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>xembed-core-common</module>
    <module>xembed-core</module>
    <module>xembed-core-win32</module>
    <module>xembed-host</module>
    <module>xembed-client</module>
    <module>xembed-demo</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jna.version>5.19.1</jna.version>
    <junit.version>5.11.3</junit.version>
    <!-- See the maven-surefire-plugin <jvm> configuration below and
         .mvn/xserver-jvm-wrapper/bin/java. Override on the command line,
         e.g. `-Dtest.xserver=Xephyr` to watch tests run, or
         `-Dtest.xserver=` to opt out and run against whatever DISPLAY you
         already have (or none). -->
    <test.xserver>Xvfb</test.xserver>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna</artifactId>
        <version>${jna.version}</version>
      </dependency>
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna-platform</artifactId>
        <version>${jna.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- JNA loads its native library via System::load, which triggers a JEP 472
                 restricted-method warning on JDK 24+. Silence it for the test fork.
                 The two "add opens" flags below are for CanvasNativeHandle's reflection
                 into java.awt.Component's package-private peer field and the X11 peer's
                 own getWindow() accessor - see that class's Javadoc. .mvn/jvm.config
                 carries the same two flags for Maven's own JVM (what exec:java runs in),
                 but that file has no effect on this plugin's forked test JVM, so they're
                 repeated here. -->
            <argLine>--enable-native-access=ALL-UNNAMED --add-opens java.desktop/java.awt=ALL-UNNAMED --add-opens java.desktop/sun.awt.X11=ALL-UNNAMED</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
          <configuration>
            <!-- Don't warn about missing comments/@param/@return; still check that
                 whatever Javadoc does exist is well-formed. -->
            <doclint>all,-missing</doclint>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Local-only packaging: every module's `mvn install` also produces a
        sources jar and a javadoc jar alongside the class jar, so a
        dependency picked up from the local repo (../.m2) has real IDE
        source/doc lookup. No distributionManagement here — nothing is
        configured to be pushed anywhere.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The Xvfb/openbox wrapper only makes sense on Linux/X11 - Windows has
         no DISPLAY, no Xvfb, and can't launch a shebang script as the forked
         test JVM's executable in the first place (CreateProcess needs a real
         PE binary, not a bash script). So this is a separate, unix-only
         profile rather than base pluginManagement: on windows-latest CI (or
         any Windows dev machine), the forked test JVM is surefire's own
         plain default fork, and the @EnabledOnOs(OS.WINDOWS)/DISPLAY-gated
         tests sort themselves out from there. -->
    <profile>
      <id>xserver-jvm-wrapper</id>
      <activation>
        <os>
          <family>unix</family>
        </os>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <!-- Launch the forked test JVM through a wrapper script instead of `java`
                     directly, so DISPLAY can be set (for tests gated on it - see README.md's
                     "Running tests" section) *before* that JVM starts. It has to happen that
                     early: a JVM decides whether it's headless from the DISPLAY it sees at
                     startup, and separately, once Maven's own JVM is running, nothing inside
                     it can hand the fork a DISPLAY it didn't already have - confirmed while
                     building this, both via a Maven property (interpolated once when the
                     reactor's build plan is put together, long before any phase/goal that
                     could produce a fresh value runs) and via a real libc setenv() call on
                     Maven's own process (maven-surefire-plugin's fork, via
                     plexus/maven-shared-utils Commandline, always builds the child's
                     environment from Java's System.getenv() snapshot - itself frozen at JVM
                     startup - rather than the live OS environment, so neither route ever
                     reaches the child). See .mvn/xserver-jvm-wrapper/bin/java for what the
                     wrapper actually does - it has to live at exactly
                     "<something>/bin/java<something>" (surefire's SystemUtils.endsWithJavaPath
                     requires a filename starting with "java" inside a directory literally named
                     "bin"), mimicking a real JDK install's own bin/java layout. -->
                <jvm>${maven.multiModuleProjectDirectory}/.mvn/xserver-jvm-wrapper/bin/java</jvm>
                <environmentVariables>
                  <ORIG_JAVA_HOME>${java.home}</ORIG_JAVA_HOME>
                  <X_SERVER>${test.xserver}</X_SERVER>
                </environmentVariables>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
