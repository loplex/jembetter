#!/usr/bin/env bash

# This is a fake `java` command of faked JRE.
# It wraps calling the jUnit original real `java` command
# used as a forked test process executor.

# It is used in `maven-surefire-plugin`'s <jvm> configuration property
# (see root `pom.xml`).

# What it does:
#
#   First, it sources two scripts:
#   1. `provide_platform_java.sh`:
#        - sets `$java_bin` env. variable (path to real java)
#   2. `spawn-xserver.sh`:
#        - spawns X Server and X Window Manager processes (on background)
#        - sets `$DISPLAY` env. variable (display number of target X server, e.g. :99)
#
#   Then it calls the real `java` command, passing all env. variables and arguments.

set -eu

jvm_wrapper_dir="$( dirname "$0" )/.."


declare -x DISPLAY java_bin

source "${jvm_wrapper_dir}/provide_platform_java.sh"

source "${jvm_wrapper_dir}/spawn-xserver.sh"

#"$java_bin" "$@"

runJava "$@"
