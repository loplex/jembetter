#!/usr/bin/env bash
set -eu

# This is a fake `java` command of faked JRE.
# It wraps calling the jUnit original real `java` command
# used as a forked test process executor.

# It is used in `maven-surefire-plugin`'s <jvm> configuration property
# (see root `pom.xml`).

# What it does:
#
#   It runs `spawn-xserver.sh`, which spawns an X server and X window
#   manager (on background), sets `$DISPLAY`, and then runs
#   `provide-platform-java.sh` (passed to it as the command to run once
#   the X server is up), which in turn runs the real `java` command for
#   the current platform - native on Linux, or under Wine for the
#   @Tag("windows") suite (see that script for details) - passing all
#   arguments through unmodified.

jvm_wrapper_dir=$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )

"${jvm_wrapper_dir}/spawn-xserver.sh" \
  "${jvm_wrapper_dir}/provide-platform-java.sh" \
  "$@"
